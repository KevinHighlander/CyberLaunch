{
  "name": "cyberlaunch-assistant",
  "displayName": "Cyber Launch Assistant",
  "description": "A secure, project-aware AI coding assistant for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:cyberlaunch-assistant.inspectSelectedCode",
    "onCommand:cyberlaunch-assistant.explainSelectedCode",
    "onCommand:cyberlaunch-assistant.findBugs",
    "onCommand:cyberlaunch-assistant.securityReview",
    "onCommand:cyberlaunch-assistant.improveSelectedCode",
    "onCommand:cyberlaunch-assistant.setApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cyberlaunch-assistant.inspectSelectedCode",
        "title": "CyberLaunch: Inspect Selected Code"
      },
      {
        "command": "cyberlaunch-assistant.explainSelectedCode",
        "title": "CyberLaunch: Explain Selected Code"
      },
      {
        "command": "cyberlaunch-assistant.findBugs",
        "title": "CyberLaunch: Find Bugs in Selected Code"
      },
      {
        "command": "cyberlaunch-assistant.securityReview",
        "title": "CyberLaunch: Security Review Selected Code"
      },
      {
        "command": "cyberlaunch-assistant.improveSelectedCode",
        "title": "CyberLaunch: Improve Selected Code"
      },
      {
        "command": "cyberlaunch-assistant.setApiKey",
        "title": "CyberLaunch: Set OpenAI API Key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cyberlaunch-assistant.explainSelectedCode",
          "group": "cyberlaunch@1",
          "when": "editorHasSelection"
        },
        {
          "command": "cyberlaunch-assistant.findBugs",
          "group": "cyberlaunch@2",
          "when": "editorHasSelection"
        },
        {
          "command": "cyberlaunch-assistant.securityReview",
          "group": "cyberlaunch@3",
          "when": "editorHasSelection"
        },
        {
          "command": "cyberlaunch-assistant.improveSelectedCode",
          "group": "cyberlaunch@4",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "openai": "^7.3.0"
  }
}
