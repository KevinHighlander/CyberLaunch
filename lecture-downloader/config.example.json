{
  "download_dir": "downloads",
  "state_file": ".lecture-downloader-state.json",
  "timeout_seconds": 30,
  "max_file_size_mb": 100,
  "extensions": [".pdf", ".ppt", ".pptx", ".doc", ".docx", ".txt"],
  "allowed_hosts": ["files.example.edu"],
  "courses": [
    {
      "name": "COURSE 101",
